# clasp local credentials / project config — generated in CI, never commit
.clasprc.json
.clasp.json

# node (only used transiently for clasp; no package.json in this repo)
node_modules/

# Obsidian knowledge vault — local-only, never pushed to the public repo.
# The vault ROOT is the repo root (so CHANGELOG.md, ARCHITECTURE.md and friends are
# real, linkable notes); `vault/` holds the notes that are about the vault itself,
# and `.obsidian/` is config + ~20 plugin bundles. Neither belongs in a public repo.
vault/
.obsidian/

# The vault's portable bootstrap spec — a local input to vault/, already applied.
# Ignored so it stops reading as a pending instruction to the next agent.
VAULT_BOOTSTRAP.md

# OSM extracts and the district builder's scratch files. The Ontario .pbf is ~1 GB
# — past GitHub's 100 MB per-file limit — and belongs in the OSRM data folder
# (D:\osrm), never in the repo. Ignored so a stray copy downloaded next to data/
# can't be swept into a commit by `git add -A`.
*.osm.pbf
_build_*

# graphify's knowledge graph — derived data, rebuilt from source by the post-commit
# hook. Committing it would mean a graph diff on every code commit, and a checked-in
# graph goes stale the moment someone commits without the hook installed.
graphify-out/
